{
  "name": "zen-pi",
  "version": "0.6.11",
  "private": true,
  "description": "Zen Pi：一般、學習與研究模式，來源記憶與 Workspace Web UI",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/study/index.ts"
    ],
    "skills": [],
    "prompts": []
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "check": "node scripts/check-study.mjs && node scripts/build-vendor.mjs --check",
    "web": "node web/server.mjs",
    "web:install": "node scripts/install-web-service.mjs",
    "build:web": "node scripts/build-vendor.mjs",
    "test:web-layout": "node test/browser/layout.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "katex": "0.18.7",
    "mermaid": "11.17.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  }
}
